<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only — web search (DuckDuckGo) and model downloads (Hugging Face). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
